# ─────────────────────────────────────────────────────────────────────────────
# Spicy Garden — environment variables
# Copy to .env.local for development. In production set these in
# Vercel → Project → Settings → Environment Variables.
# The app has NO hardcoded fallbacks: missing required values make the
# affected feature refuse to run.
# Random secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Owner portal (required) ──────────────────────────────────────────────────
# Login email for the owner portal.
OWNER_EMAIL=
# scrypt hash of the owner password. Generate with: node scripts/hash-password.mjs
OWNER_PASSWORD_HASH=
# Random secret (>= 32 chars) used to sign session tokens. Rotating it logs everyone out.
ADMIN_SESSION_SECRET=

# ── Customer data encryption (required) ──────────────────────────────────────
# Random secret (>= 32 chars), must differ from ADMIN_SESSION_SECRET. Do NOT rotate
# without running the re-encryption migration, or stored phone numbers become unreadable.
DATA_ENCRYPTION_KEY=
# Optional, temporary: previous secret used to encrypt old records (only until migrated).
LEGACY_DATA_ENCRYPTION_SECRET=

# ── Firebase Realtime Database (required) ────────────────────────────────────
FIREBASE_DATABASE_URL=
# Service account JSON, base64-encoded (preferred on Vercel) ...
FIREBASE_SERVICE_ACCOUNT_KEY=
# ... or the individual fields instead:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Ably realtime order alerts (required) ────────────────────────────────────
ABLY_API_KEY=
# Optional channel name (default: order)
ABLY_ORDERS_CHANNEL=

# ── Payments (required for production builds) ────────────────────────────────
# Restaurant UPI VPA shown to customers (e.g. name@bank). Inlined at build time.
NEXT_PUBLIC_RESTAURANT_UPI_ID=

# ── Cloudinary image uploads (required for admin image uploads) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp Business Cloud API (optional) ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NEXT_PUBLIC_ENABLE_WHATSAPP_OPTIN=
NEXT_PUBLIC_WHATSAPP_OPTIN_SCORE_THRESHOLD=

# ── Google Places rating (optional) ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
